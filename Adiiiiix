local function inList(list, k)
    for _, v in ipairs(list) do
        if v == k then return true end
    end
    return false
end

local function fmt(sec)
    local h = math.floor(sec / 3600)
    local m = math.floor((sec % 3600) / 60)
    local s = sec % 60
    return string.format("%02d:%02d:%02d", h, m, s)
end

local function loadUsed()
    local used = {}
    pcall(function()
        if isfile and isfile(SAVE_FILE) then
            for k, t, d in string.gmatch(readfile(SAVE_FILE), "(%w+),(%d+),(%d+)") do
                used[k] = { t = tonumber(t), d = tonumber(d) }
            end
        end
    end)
    return used
end

local function saveUsed(used)
    pcall(function()
        if writefile then
            local parts = {}
            for k, v in pairs(used) do
                parts[#parts + 1] = k .. "," .. tostring(v.t) .. "," .. tostring(v.d)
            end
            writefile(SAVE_FILE, table.concat(parts, "|"))
        end
    end)
end

local used = loadUsed()

local function activeLeft()
    for _, v in pairs(used) do
        local left = v.d - (os.time() - v.t)
        if left > 0 then return left end
    end
    return nil
end

local function runPayload()
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(SCRIPT_URL))()
        end)
        if not ok then warn("Script error: " .. tostring(err)) end
    end)
end

local function runScript(timeLeft)
    runPayload()
    task.spawn(function()
        local sg = Instance.new("ScreenGui")
        sg.Name = "AdiixTimer"
        sg.ResetOnSpawn = false
        pcall(function()
            sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 200, 0, 30)
        lbl.Position = UDim2.new(0.5, -100, 0, 10)
        lbl.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        lbl.BackgroundTransparency = 0.3
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.Parent = sg
        Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 8)

        local remaining = timeLeft
        while remaining > 0 do
            lbl.Text = "⏳ Time left: " .. fmt(remaining)
            task.wait(1)
            remaining = remaining - 1
        end
        sg:Destroy()
        player:Kick("⏰ Time is over! Get a new key.")
    end)
end

local function makeLabel(parent, txt, y)
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, -20, 0, 22)
    l.Position = UDim2.new(0, 10, 0, y)
    l.BackgroundTransparency = 1
    l.Text = txt
    l.TextColor3 = Color3.fromRGB(230, 230, 230)
    l.Font = Enum.Font.Gotham
    l.TextSize = 14
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

