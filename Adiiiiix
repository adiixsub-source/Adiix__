--============================================--
--   🔑 Adiix Key System - حماية بـ ٣٠ كود   --
--============================================--

local DURATION  = 1800  -- مدة الكود: 30 دقيقة (بالثواني)
local SAVE_FILE = "adiix_used_keys.txt" -- ملف حفظ الأكواد المستعملة
local SCRIPT_URL = "https://raw.githubusercontent.com/adiixsub-source/Adiiiiiix/refs/heads/main/Adiix"

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local player = Players.LocalPlayer

-- الأكواد الثلاثين
local KEYS = {
    "2KEAB7", "2S2RR5", "2WAM5C", "5P5NRR", "6GSEWW", "6YQJ5E",
    "8KF8S7", "8M5A5T", "AK23FG", "E5F6TW", "FGBM2J", "JEKWA9",
    "JYJ2J6", "MPPDGS", "P55SRG", "PK593R", "PT7WZG", "PUQ57W",
    "QXBWCA", "RDNV9X", "SAPFBH", "SJARJB", "TYZY38", "URZ525",
    "WNDFX5", "WR8PJV", "X7MH4X", "YWAM64", "Z3D4M4", "ZCNBJD",
}

-- ✅ تحميل الأكواد المستعملة من الملف (يتذكر حتى لو طلع ورجع)
local used = {}
pcall(function()
    if isfile and isfile(SAVE_FILE) then
        local data = HttpService:JSONDecode(readfile(SAVE_FILE))
        if type(data) == "table" then used = data end
    end
end)

local function saveUsed()
    pcall(function()
        if writefile then
            writefile(SAVE_FILE, HttpService:JSONEncode(used))
        end
    end)
end

-- ✅ فحص إذا عنده كود شغال حالياً (لسه ما خلصت الـ 30 دقيقة)
local function getActiveTimeLeft()
    for _, t in pairs(used) do
        local left = DURATION - (os.time() - t)
        if left > 0 then
            return left
        end
    end
    return nil
end

-- ✅ تشغيل السكربت الأصلي + عداد الوقت + طرد عند الانتهاء
local function runScript(timeLeft)
    task.spawn(function()
        local ok, err = pcall(function()
            loadstring(game:HttpGet(SCRIPT_URL))()
        end)
        if not ok then warn("Script error: " .. tostring(err)) end
    end)

    -- عداد صغير يبين الوقت الباقي
    task.spawn(function()
        local sg = Instance.new("ScreenGui")
        sg.Name = "AdiixTimer"
        sg.ResetOnSpawn = false
        pcall(function()
            sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
        end)
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(0, 180, 0, 30)
        lbl.Position = UDim2.new(0.5, -90, 0, 10)
        lbl.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
        lbl.BackgroundTransparency = 0.3
        lbl.TextColor3 = Color3.new(1, 1, 1)
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 14
        lbl.Parent = sg
        Instance.new("UICorner", lbl).CornerRadius = UDim.new(0, 8)

        local remaining = timeLeft
        while remaining > 0 do
            lbl.Text = string.format("⏳ Time left: %02d:%02d", math.floor(remaining / 60), remaining % 60)
            task.wait(1)
            remaining -= 1
        end
        sg:Destroy()
        -- ⛔ خلص الوقت: يطلعه من اللعبة ويطلب الكود التالي لما يرجع
        player:Kick("⏰ Your 30 minutes are over! Get the next key.")
    end)
end

-- ✅ نافذة إدخال الكود
local function showKeyUI()
    local sg = Instance.new("ScreenGui")
    sg.Name = "AdiixKeySystem"
    sg.ResetOnSpawn = false
    pcall(function()
        sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)

    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 180)
    frame.Position = UDim2.new(0.5, -150, 0.5, -90)
    frame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    frame.BorderSizePixel = 0
    frame.Parent = sg
    Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 10)

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, 0, 0, 40)
    title.BackgroundTransparency = 1
    title.Text = "🔑 Adiix Key System"
    title.TextColor3 = Color3.new(1, 1, 1)
    title.Font = Enum.Font.GothamBold
    title.TextSize = 18
    title.Parent = frame

    local box = Instance.new("TextBox")
    box.Size = UDim2.new(1, -40, 0, 40)
    box.Position = UDim2.new(0, 20, 0, 50)
    box.PlaceholderText = "Enter your 6-digit key..."
    box.Text = ""
    box.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    box.TextColor3 = Color3.new(1, 1, 1)
    box.Font = Enum.Font.Gotham
    box.TextSize = 16
    box.Parent = frame
    Instance.new("UICorner", box).CornerRadius = UDim.new(0, 8)

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -40, 0, 36)
    btn.Position = UDim2.new(0, 20, 0, 100)
    btn.BackgroundColor3 = Color3.fromRGB(0, 170, 90)
    btn.Text = "✔ Submit"
    btn.TextColor3 = Color3.new(1, 1, 1)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 16
    btn.Parent = frame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local status = Instance.new("TextLabel")
    status.Size = UDim2.new(1, 0, 0, 26)
    status.Position = UDim2.new(0, 0, 1, -28)
    status.BackgroundTransparency = 1
    status.Text = ""
    status.TextColor3 = Color3.fromRGB(255, 80, 80)
    status.Font = Enum.Font.Gotham
    status.TextSize = 13
    status.Parent = frame

    btn.MouseButton1Click:Connect(function()
        local input = box.Text:gsub("%s+", ""):upper()

        if #input ~= 6 then
            status.Text = "❌ Key must be 6 characters!"
            return
        end

        -- ⛔ كود مستعمل من قبل؟ ما يرجع يشتغل أبداً
        if used[input] then
            status.Text = "❌ This key was already used!"
            return
        end

        local valid = false
        for _, k in ipairs(KEYS) do
            if k == input then valid = true break end
        end
        if not valid then
            status.Text = "❌ Wrong key!"
            return
        end

        -- ✅ نجاح: سجل الكود واحفظه وأخفِ الواجهة فوراً
        used[input] = os.time()
        saveUsed()
        sg:Destroy()          -- ⬅️ الواجهة تختفي بنفس اللحظة
        runScript(DURATION)
    end)
end

-- ✅ البداية: إذا عنده كود شغال يكمل، غيره يطلب كود جديد
local timeLeft = getActiveTimeLeft()
if timeLeft then
    runScript(timeLeft)
else
    showKeyUI()
end
