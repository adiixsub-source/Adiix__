local function playIntro(onDone)
    local sg = Instance.new("ScreenGui")
    sg.Name = "AdiixIntro"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    pcall(function()
        sg.Parent = (gethui and gethui()) or game:GetService("CoreGui")
    end)

    -- شاشة سوداء كاملة
    local bg = Instance.new("Frame")
    bg.Size = UDim2.new(1, 0, 1, 0)
    bg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    bg.BorderSizePixel = 0
    bg.Parent = sg

    -- الصورة الدائرية بالنص
    local img = Instance.new("ImageLabel")
    img.Size = UDim2.new(0, 300, 0, 300)
    img.Position = UDim2.new(0.5, -150, 0.5, -150)
    img.BackgroundTransparency = 1
    img.ImageTransparency = 1
    img.Parent = bg
    Instance.new("UICorner", img).CornerRadius = UDim.new(1, 0) -- ⭕ شكل دائري

    -- ⬇️ تحميل الصورة والأغنية تلقائياً من GitHub (أول مرة فقط)
    pcall(function()
        if getcustomasset and writefile then
            if not (isfile and isfile(INTRO_IMG)) then
                writefile(INTRO_IMG, game:HttpGet(IMG_URL))
            end
            img.Image = getcustomasset(INTRO_IMG)
        end
    end)

    local snd = nil
    pcall(function()
        if getcustomasset and writefile then
            if not (isfile and isfile(INTRO_SONG)) then
                writefile(INTRO_SONG, game:HttpGet(SONG_URL))
            end
            snd = Instance.new("Sound")
            snd.SoundId = getcustomasset(INTRO_SONG)
            snd.Volume = 1
            snd.Parent = bg
            snd:Play()
        end
    end)

    -- زر Skip فوق يمين
    local skip = Instance.new("TextButton")
    skip.Size = UDim2.new(0, 90, 0, 32)
    skip.Position = UDim2.new(1, -100, 0, 12)
    skip.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    skip.TextColor3 = Color3.new(1, 1, 1)
    skip.Font = Enum.Font.GothamBold
    skip.TextSize = 14
    skip.Text = "Skip ➤"
    skip.BackgroundTransparency = 1
    skip.TextTransparency = 1
    skip.Parent = bg
    Instance.new("UICorner", skip).CornerRadius = UDim.new(0, 8)

    local ended = false
    local function endIntro()
        if ended then return end
        ended = true
        pcall(function()
            if snd then snd:Stop() snd:Destroy() end
        end)
        sg:Destroy()
        onDone()
    end
    skip.MouseButton1Click:Connect(endIntro)

    task.spawn(function()
        for i = 10, 0, -1 do
            img.ImageTransparency = i / 10
            skip.TextTransparency = i / 10
            skip.BackgroundTransparency = i / 10
            task.wait(0.05)
        end
        local t = 0
        local rot = 0
        while t < INTRO_TIME do
            t = t + 0.05
            rot = (rot + 4) % 360   -- 🌀 الصورة تدور مع الأغنية
            img.Rotation = rot
            task.wait(0.05)
        end
        endIntro()
    end)
end

